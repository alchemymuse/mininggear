{
  "name": "mininggear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "prod:generate": "prisma generate --schema=prisma/schema.prod.prisma",
    "prod:migrate": "prisma migrate dev --schema=prisma/schema.prod.prisma",
    "prod:deploy": "prisma migrate deploy --schema=prisma/schema.prod.prisma",
    "prod:seed": "prisma generate --schema=prisma/schema.prod.prisma && tsx prisma/seed.ts",
    "vercel-build": "prisma generate --schema=prisma/schema.prod.prisma && next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "mammoth": "^1.8.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
