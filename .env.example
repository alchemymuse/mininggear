# ---- Database ----
# Local dev (SQLite, default):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL — Neon / Supabase). Used with prisma/schema.prod.prisma:
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"   # pooled connection
# DIRECT_URL="postgresql://USER:PASS@HOST/db?sslmode=require"     # direct, for migrations

# ---- Auth.js (required everywhere) ----
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- File storage ----
STORAGE_DRIVER="local"          # "local" or "r2"
# R2_ACCOUNT_ID="" R2_ACCESS_KEY_ID="" R2_SECRET_ACCESS_KEY="" R2_BUCKET="" R2_PUBLIC_BASE_URL=""

# ---- Email ----
RESEND_API_KEY=""               # blank = print emails to console (dev)
MAIL_FROM="MiningGear <onboarding@resend.dev>"
APP_URL="http://localhost:3000" # used for links in emails
